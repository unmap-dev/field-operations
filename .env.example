# Your Unmap browser key, from https://unmap.dev/dashboard (free).
# It ships in the browser bundle: restrict it to your origins (e.g. http://localhost:3206 and your
# production domain) in the dashboard.
NEXT_PUBLIC_UNMAP_KEY=

# Optional. Defaults to https://api.unmap.dev.
# NEXT_PUBLIC_UNMAP_GATEWAY=https://api.unmap.dev

# Optional. The path the app is served under, e.g. /field. Empty for a site of its own.
# BASE_PATH=

# Which Unmap add-ons your key has, comma-separated: energy, legal-land. Leave empty for sample
# mode: the work orders and the free layers work, and the energy layers, well search and legal
# land search say which add-on they need. Only list an add-on your key really has; the gateway
# refuses the rest with addon_required.
NEXT_PUBLIC_UNMAP_ADDONS=
